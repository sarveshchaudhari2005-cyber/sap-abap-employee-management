
REPORT ZEMP_MANAGEMNT_REPORT.

TABLES: ZEMP_PORT.

DATA: IT_E TYPE STANDARD TABLE OF ZEMP_PORT.
DATA: WA_E TYPE ZEMP_PORT.
DATA: V_COUNT TYPE I.
DATA: V_TOTAL_SALARY TYPE P DECIMALS 2.
DATA: V_AVG_SALARY TYPE P DECIMALS 2.

SELECT-OPTIONS:
  S_EMPID FOR ZEMP_PORT-EMP_ID,
  S_DEPT FOR ZEMP_PORT-DEPARTMENT,
  S_NAME FOR ZEMP_PORT-EMP_NAME,
  S_DATE FOR ZEMP_PORT-JOIN_DATE.

PARAMETERS:
  P_SALARY TYPE ZEMP_PORT-SALARY.

AT SELECTION-SCREEN.

  IF P_SALARY < 0.
    MESSAGE 'SALARY CANNOT BE NEGATIVE' TYPE 'E'.
  ENDIF.

START-OF-SELECTION.

  SELECT *
    FROM ZEMP_PORT
    INTO TABLE IT_E
    WHERE EMP_ID IN S_EMPID
      AND DEPARTMENT IN S_DEPT
      AND EMP_NAME IN S_NAME
      AND JOIN_DATE IN S_DATE
      AND SALARY >= P_SALARY.

  IF SY-SUBRC = 0.

    LOOP AT IT_E INTO WA_E.

      WRITE: / WA_E-EMP_ID,
               WA_E-EMP_NAME,
               WA_E-DEPARTMENT,
               WA_E-SALARY.

      V_COUNT = V_COUNT + 1.
      V_TOTAL_SALARY = V_TOTAL_SALARY + WA_E-SALARY.

    ENDLOOP.

    V_AVG_SALARY = V_TOTAL_SALARY / V_COUNT.

    ULINE.

    WRITE: / 'TOTAL EMPLOYEES FOUND', V_COUNT.
    WRITE: / 'TOTAL SALARY', V_TOTAL_SALARY.
    WRITE: / 'AVERAGE SALARY', V_AVG_SALARY.

  ELSE.

    WRITE: / 'NO EMPLOYEE RECORDS FOUND'.

  ENDIF.
